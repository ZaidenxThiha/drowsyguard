{
  "name": "drowsyguard",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based driver drowsiness and distraction detector built on MediaPipe Face Landmarker (Computer Vision midterm project, IU).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npm run build && node tools/serve.mjs",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:web": "node tools/browser_check.mjs",
    "verify": "npm test && npm run verify:web"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304"
  }
}
